# =============================================================================
# Engenox MVP - Local Development Environment Variables
# Copy to .env.local and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# AI PROVIDER API KEYS (REQUIRED for Gateway 6 seams)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key
GOOGLE_API_KEY=your-gemini-key-optional

# -----------------------------------------------------------------------------
# LOCAL INFRASTRUCTURE (docker-compose.dev.yml services)
# -----------------------------------------------------------------------------
# Postgres + AGE + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=engenox
POSTGRES_USER=engenox
POSTGRES_PASSWORD=localdevpassword
DATABASE_URL=postgresql://engenox:localdevpassword@localhost:5432/engenox

# Valkey (Redis-compatible)
VALKEY_HOST=localhost
VALKEY_PORT=6379

# Redpanda (Kafka API)
KAFKA_BROKERS=localhost:9092

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# MinIO (S3-compatible, simulates Cloudflare R2)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=engenox-corpus
MINIO_USE_SSL=false

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# -----------------------------------------------------------------------------
# GATEWAY SERVICE (services/gateway)
# -----------------------------------------------------------------------------
GATEWAY_PORT=8080
GATEWAY_LOG_LEVEL=debug

# Per-seam ModelSpec (pinned versions - update with ADR for changes)
MODEL_EXTRACT=claude-3-5-haiku-20241022
MODEL_DRAFT=claude-3-5-sonnet-20241022
MODEL_ADJUDICATE=claude-3-opus-20240229
MODEL_EMBED=claude-3-5-haiku-20241022
MODEL_ABDUCE=claude-3-opus-20240229
MODEL_CRITIQUE=gpt-5-2024-XX-XX
# MODEL_ABDUCE_FALLBACK=claude-fable-5 (optional, per-tenant opt-in)

# Token budgets (per tenant per day)
TOKEN_BUDGET_DAILY_STARTER=500000
TOKEN_BUDGET_DAILY_CONCIERGE=2000000

# Constrained decoding
CONSTRAINED_DECODING_ENABLED=true
OUTLINES_CACHE_DIR=/tmp/outlines-cache

# -----------------------------------------------------------------------------
# PERCEPTION SERVICE (services/perception)
# -----------------------------------------------------------------------------
PERCEPTION_PORT=8081
PERCEPTION_GATEWAY_URL=http://localhost:8080
PERCEPTION_MEASUREMENT_URL=http://localhost:8083
PERCEPTION_DB_URL=${DATABASE_URL}

# Probe scheduler
PROBE_M_SURFACES=5
PROBE_N_QUERIES=10
PROBE_K_SAMPLES=3
PROBE_CONCURRENCY=10
PROBE_COOLDOWN_SECONDS=300
PROBE_TIMEOUT_SECONDS=30

# Connectors (MVP subset: GSC, GA4, Git, CMS)
GSC_CLIENT_ID=your-gsc-client-id
GSC_CLIENT_SECRET=your-gsc-client-secret
GA4_PROPERTY_ID=your-ga4-property-id
GA4_SERVICE_ACCOUNT_JSON=path/to/ga4-sa.json
GIT_PROVIDER=github
GIT_TOKEN=your-github-token
CMS_TYPE=contentful
CMS_API_KEY=your-cms-api-key

# Consent
CONSENT_LEDGER_STRATEGY=RCT_ELIGIBLE

# -----------------------------------------------------------------------------
# ACTION SERVICE (services/action)
# -----------------------------------------------------------------------------
ACTION_PORT=8082
ACTION_DB_URL=${DATABASE_URL}
ACTION_GATEWAY_URL=http://localhost:8080
ACTION_PERCEPTION_URL=http://localhost:8081

# Dial
DAL_LEVEL_DEFAULT=propose
DAL_ESCALATION_AXIS_THRESHOLD=3
DAL_DEMOTE_ALERT_THRESHOLD=3
DAL_DEMOTE_WINDOW_HOURS=24

# GitHub App (for F7 PR connector)
GITHUB_APP_ID=your-app-id
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
GITHUB_APP_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------------------------------------------------------
# MEASUREMENT SERVICE (services/measurement)
# -----------------------------------------------------------------------------
MEASUREMENT_PORT=8083
MEASUREMENT_DB_URL=${DATABASE_URL}
MEASUREMENT_MINIO_ENDPOINT=${MINIO_ENDPOINT}
MEASUREMENT_MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
MEASUREMENT_MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
MEASUREMENT_MINIO_BUCKET=${MINIO_BUCKET}

# Estimators
SCM_DONOR_POOL_SIZE=100
DML_N_FOLDS=5
CONFORMAL_ALPHA=0.1
EWMA_ALPHA=0.3
CUSUM_THRESHOLD=5.0

# Quarantine
QUARANTINE_AUTO_ENABLE=true
QUARANTINE_HUMAN_REVIEW_REQUIRED=true

# -----------------------------------------------------------------------------
# CONTROL PLANE (services/control-plane)
# -----------------------------------------------------------------------------
CONTROL_PLANE_PORT=8084
CONTROL_PLANE_DB_URL=${DATABASE_URL}
CONTROL_PLANE_TEMPORAL_URL=${TEMPORAL_ADDRESS}
CONTROL_PLANE_PERCEPTION_URL=http://localhost:8081
CONTROL_PLANE_DECISION_URL=http://localhost:8085
CONTROL_PLANE_ACTION_URL=http://localhost:8082
CONTROL_PLANE_MEASUREMENT_URL=http://localhost:8083

# Canary cohort
CANARY_COHORT_TENANT_IDS=tenant-1,tenant-2,tenant-3

# -----------------------------------------------------------------------------
# DECISION SERVICE (services/decision)
# -----------------------------------------------------------------------------
DECISION_PORT=8085
DECISION_GATEWAY_URL=http://localhost:8080
DECISION_DB_URL=${DATABASE_URL}

# -----------------------------------------------------------------------------
# TEMPORAL (services/temporal)
# -----------------------------------------------------------------------------
TEMPORAL_PORT=7233
TEMPORAL_DB_URL=${DATABASE_URL}

# -----------------------------------------------------------------------------
# WEB APP (web/)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8084
NEXT_PUBLIC_WS_URL=ws://localhost:8084

# Local auth mock (JWT with app.tenant_id claim)
JWT_SECRET=local-dev-secret-change-in-prod
JWT_ISSUER=engenox-local
JWT_AUDIENCE=engenox-web

# WorkOS (mock in local, real in prod)
WORKOS_CLIENT_ID=mock
WORKOS_API_KEY=mock
WORKOS_COOKIE_PASSWORD=local-dev-cookie-password-32-chars

# Stripe (mock in local, test mode in prod)
STRIPE_PUBLISHABLE_KEY=pk_test_mock
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_mock
STRIPE_PRICE_ID_STARTER=price_mock

# Feature flags
NEXT_PUBLIC_ENABLE_CONCIERGE=true
NEXT_PUBLIC_ENABLE_STARTER=true

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=engenox
LANGUFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-mock
LANGFUSE_SECRET_KEY=sk-lf-mock

# -----------------------------------------------------------------------------
# SECURITY (local defaults - override in prod)
# -----------------------------------------------------------------------------
CSP_NONCE_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# -----------------------------------------------------------------------------
# MIGRATIONS (Atlas)
# -----------------------------------------------------------------------------
ATLAS_URL=${DATABASE_URL}?search_path=public,ag_catalog

# -----------------------------------------------------------------------------
# SEEDING (founder cohort)
# -----------------------------------------------------------------------------
SEED_FOUNDER_TENANTS=tenant-1,tenant-2,tenant-3
SEED_SURFACES_PER_TENANT=5