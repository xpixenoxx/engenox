{
  "name": "@engenox/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Engenox contract spine (24 S2) - the ONLY cross-language type source. Generated from Protobuf by `buf generate`; imported as the typed surface by services + web.",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./entity/v1": {
      "types": "./generated/ts/engenox/entity/v1/entity_pb.d.ts",
      "import": "./generated/ts/engenox/entity/v1/entity_pb.js"
    },
    "./entity/v1/surface": {
      "types": "./generated/ts/engenox/entity/v1/surface_pb.d.ts",
      "import": "./generated/ts/engenox/entity/v1/surface_pb.js"
    },
    "./entity/v1/brand": {
      "types": "./generated/ts/engenox/entity/v1/brand_pb.d.ts",
      "import": "./generated/ts/engenox/entity/v1/brand_pb.js"
    },
    "./entity/v1/conflict": {
      "types": "./generated/ts/engenox/entity/v1/conflict_pb.d.ts",
      "import": "./generated/ts/engenox/entity/v1/conflict_pb.js"
    },
    "./entity/v1/intervention": {
      "types": "./generated/ts/engenox/entity/v1/intervention_pb.d.ts",
      "import": "./generated/ts/engenox/entity/v1/intervention_pb.js"
    },
    "./entity/v1/integrity": {
      "types": "./generated/ts/engenox/entity/v1/integrity_pb.d.ts",
      "import": "./generated/ts/engenox/entity/v1/integrity_pb.js"
    },
    "./event/v1": {
      "types": "./generated/ts/engenox/event/v1/event_pb.d.ts",
      "import": "./generated/ts/engenox/event/v1/event_pb.js"
    },
    "./service/v1": {
      "types": "./generated/ts/engenox/service/v1/service_pb.d.ts",
      "import": "./generated/ts/engenox/service/v1/service_pb.js"
    },
    "./service/v1/gateway": {
      "types": "./generated/ts/engenox/service/v1/gateway_pb.d.ts",
      "import": "./generated/ts/engenox/service/v1/gateway_pb.js"
    },
    "./service/v1/gateway/connect": {
      "types": "./generated/ts/engenox/service/v1/gateway_pb.d.ts",
      "import": "./generated/ts/engenox/service/v1/gateway_pb.js"
    },
    "./service/v1/controlplane": {
      "types": "./generated/ts/engenox/service/v1/controlplane_pb.d.ts",
      "import": "./generated/ts/engenox/service/v1/controlplane_pb.js"
    },
    "./service/v1/controlplane/connect": {
      "types": "./generated/ts/engenox/service/v1/controlplane_pb.d.ts",
      "import": "./generated/ts/engenox/service/v1/controlplane_pb.js"
    },
    "./service/v1/decision": {
      "types": "./generated/ts/engenox/service/v1/decision_pb.d.ts",
      "import": "./generated/ts/engenox/service/v1/decision_pb.js"
    },
    "./service/v1/decision/connect": {
      "types": "./generated/ts/engenox/service/v1/decision_pb.d.ts",
      "import": "./generated/ts/engenox/service/v1/decision_pb.js"
    },
    "./service/v1/action": {
      "types": "./generated/ts/engenox/service/v1/action_pb.d.ts",
      "import": "./generated/ts/engenox/service/v1/action_pb.js"
    },
    "./service/v1/action/connect": {
      "types": "./generated/ts/engenox/service/v1/action_pb.d.ts",
      "import": "./generated/ts/engenox/service/v1/action_pb.js"
    },
    "./service/v1/measurement": {
      "types": "./generated/ts/engenox/service/v1/measurement_pb.d.ts",
      "import": "./generated/ts/engenox/service/v1/measurement_pb.js"
    },
    "./service/v1/measurement/connect": {
      "types": "./generated/ts/engenox/service/v1/measurement_pb.d.ts",
      "import": "./generated/ts/engenox/service/v1/measurement_pb.js"
    },
    "./service/v1/perception": {
      "types": "./generated/ts/engenox/service/v1/service_pb.d.ts",
      "import": "./generated/ts/engenox/service/v1/service_pb.js"
    },
    "./service/v1/perception/connect": {
      "types": "./generated/ts/engenox/service/v1/service_pb.d.ts",
      "import": "./generated/ts/engenox/service/v1/service_pb.js"
    },
    "./policy/v1": {
      "types": "./generated/ts/engenox/policy/v1/policy_pb.d.ts",
      "import": "./generated/ts/engenox/policy/v1/policy_pb.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "gen": "buf generate && node scripts/ensure-pyinit.mjs",
    "lint": "buf lint",
    "breaking": "buf breaking --against ../../.git#branch=main,subdir=pkg/contracts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:py": "uv run python scripts/py-roundtrip.py"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.5.0",
    "@bufbuild/protoc-gen-es": "^2.5.0",
    "@types/node": "^26.1.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
