{
  "name": "@engenox/gateway-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ConnectRPC client for GatewayService - the six bounded LLM seams as stateless functions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "lint": "biome check --write src/"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@engenox/contracts": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@types/node": "^26.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
