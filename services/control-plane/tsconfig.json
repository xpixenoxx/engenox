{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "paths": {
      "@engenox/contracts/*": ["../../pkg/contracts/generated/ts/*"],
      "@engenox/temporal/*": ["../../services/temporal/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}