    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@bufbuild/protobuf": "^2.5.0",
    "@temporalio/client": "^1.11.0",
    "@engenox/contracts": "workspace:*",
    "@engenox/crypto": "workspace:*",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@biomejs/biome": "1.9.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
