{
	"$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"include": [
			"**/*.ts",
			"**/*.tsx",
			"**/*.js",
			"**/*.cjs",
			"**/*.mjs",
			"**/*.json",
			"**/*.jsonc"
		]
	},
	"formatter": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": { "noUnreachable": "error" },
			"suspicious": { "noExplicitAny": "error" }
		}
	}
}